{
  "name": "audioblock-subgraph",
  "version": "0.1.0",
  "description": "The Graph subgraph for AudioBlock on Stellar/Soroban",
  "scripts": {
    "build": "graph build",
    "deploy": "node scripts/deploy.js",
    "deploy:testnet": "node scripts/deploy.js --environment testnet",
    "deploy:mainnet": "node scripts/deploy.js --environment mainnet",
    "codegen": "graph codegen",
    "test": "graph test",
    "deploy:hosted": "node scripts/deploy-hosted.js",
    "deploy:hosted:testnet": "node scripts/deploy-hosted.js --subgraph AudioBitsStellar/audioblock-testnet",
    "deploy:hosted:mainnet": "node scripts/deploy-hosted.js --subgraph AudioBitsStellar/audioblock"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.68.4",
    "@graphprotocol/graph-ts": "^0.33.0",
    "typescript": "^5.0.0"
  }
}
