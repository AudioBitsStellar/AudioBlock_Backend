# Copy to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars — it is listed in .gitignore.

aws_region          = "us-east-1"
ecr_image_uri       = "ghcr.io/audiobitsstellar/audioblock_backend"
image_tag           = "production-latest"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/REPLACE_ME"
kms_key_arn         = "arn:aws:kms:us-east-1:123456789012:key/REPLACE_ME"
replica_bucket_arn  = "arn:aws:s3:::audioblocks-prod-media-replica"
